{
  "name": "waitwise-workspace",
  "version": "2.0.0",
  "description": "WAITWISE – Universal Smart Queue & Crowd Management Platform (Angular 18, Node.js, Express, MongoDB, Socket.IO)",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
